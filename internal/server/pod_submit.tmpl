<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="https://fav.farm/👑" />
    <link rel="apple-touch-icon" href="https://fav.farm/👑" />
    <title>Guildmaster - Submit to {{ .Pod.Name }}</title>
            <style>
      :root {
        --bg: #09090b;
        --surface: #111113;
        --surface-2: #18181b;
        --surface-3: #1e1e23;
        --border: #27272a;
        --border-2: #3f3f46;
        --text: #e4e4e7;
        --text-muted: #71717a;
        --accent: #f7d126;
        --accent-dim: rgba(247,209,38,.15);
        --positive: #49a078;
        --negative: #c62f3b;
        --radius: 10px;
        --radius-sm: 6px;
        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; }

      @keyframes fade-up {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes pulse-accent {
        0%, 100% { box-shadow: 0 0 0 0 rgba(247,209,38,.5); }
        60% { box-shadow: 0 0 0 6px rgba(247,209,38,0); }
      }

      @keyframes shimmer {
        0% { transform: translateX(-120%); }
        100% { transform: translateX(120%); }
      }

      body {
        margin: 0;
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        background:
          radial-gradient(120% 80% at 15% -10%, #17171b 0%, transparent 55%),
          radial-gradient(80% 60% at 100% 0%, #121218 0%, transparent 60%),
          var(--bg);
        color: var(--text);
        line-height: 1.5;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1rem 2.8rem;
      }

      h1, h2, h3 {
        color: var(--text);
        letter-spacing: -0.02em;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        color: var(--accent);
        text-decoration: underline;
      }

      .nav {
        display: flex;
        gap: .75rem;
        margin-bottom: 1rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .nav a,
      .nav span {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
      }

      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
      }

      .nav-right form { margin: 0; }

      .muted,
      .subtitle,
      label {
        color: var(--text-muted);
      }

      .card,
      .metric,
      .player-block,
      details.card,
      table {
        opacity: 0;
        transform: translateY(10px);
      }

      body.loaded .card,
      body.loaded .metric,
      body.loaded .player-block,
      body.loaded details.card,
      body.loaded table {
        animation: fade-up .42s ease both;
      }

      .card,
      .metric,
      .player-block,
      details.card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 12px 34px rgba(0,0,0,.42);
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
      }

      .card:last-child,
      details.card:last-child { margin-bottom: 0; }

      .card::before,
      .metric::before,
      .player-block::before,
      details.card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        height: 1px;
        width: 100%;
        background: linear-gradient(90deg, transparent 0%, var(--accent) 50%, transparent 100%);
        opacity: 0;
        pointer-events: none;
      }

      .card:hover,
      .metric:hover,
      .player-block:hover,
      details.card:hover {
        transform: translateY(-2px);
        border-color: var(--border-2);
        box-shadow: 0 16px 38px rgba(0,0,0,.5), 0 0 0 1px rgba(247,209,38,.16), 0 0 24px rgba(247,209,38,.3);
      }

      .card:hover::before,
      .metric:hover::before,
      .player-block:hover::before,
      details.card:hover::before {
        opacity: .95;
        animation: shimmer .9s ease;
      }

      .row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding: .7rem 0;
      }

      .row:last-child { border-bottom: none; }

      table {
        width: 100%;
        border-collapse: collapse;
        font-variant-numeric: tabular-nums;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
      }

      th,
      td {
        text-align: left;
        padding: .56rem .66rem;
        border-bottom: 1px solid var(--border);
      }

      thead th {
        background: var(--surface-2);
        color: var(--text-muted);
        font-size: .74rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        font-weight: 700;
      }

      tbody tr { transition: background .15s ease; }
      tbody tr:hover { background: rgba(247,209,38,.06); }
      tbody tr:last-child td { border-bottom: none; }

      .num { text-align: right; }
      .pos, .delta-pos { color: var(--positive); font-weight: 700; }
      .neg, .delta-neg { color: var(--negative); font-weight: 700; }
      .zero, .delta-zero { color: var(--text-muted); }

      button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        width: 100%;
        border: 1px solid rgba(247,209,38,.28);
        border-radius: var(--radius-sm);
        background: linear-gradient(180deg, #f7d126 0%, #e8be20 100%);
        color: #1b1808;
        font-weight: 700;
        padding: .55rem .72rem;
        cursor: pointer;
        transition: transform .16s ease, filter .16s ease, box-shadow .16s ease;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        width: auto;
        border: 1px solid rgba(247,209,38,.28);
        border-radius: var(--radius-sm);
        background: linear-gradient(180deg, #f7d126 0%, #e8be20 100%);
        color: #1b1808;
        font-weight: 700;
        padding: .55rem .72rem;
        text-decoration: none;
        transition: transform .16s ease, filter .16s ease, box-shadow .16s ease;
      }

      button:hover,
      .btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.03);
        box-shadow: 0 0 0 1px rgba(247,209,38,.22), 0 8px 20px rgba(247,209,38,.24);
        text-decoration: none;
      }

      button:focus-visible,
      .btn:focus-visible,
      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 2px rgba(247,209,38,.2);
      }

      .nav-right button,
      .nav-right .btn,
      .rank-actions button,
      .actions button,
      .add-row button {
        width: auto;
      }

      input,
      select,
      textarea {
        width: 100%;
        background: var(--surface-2);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: .55rem .65rem;
      }

      textarea { min-height: 90px; resize: vertical; }

      label {
        display: block;
        font-size: .9rem;
        margin-bottom: .35rem;
      }

      .field { margin-bottom: .7rem; }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
      }

      .meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
      }

      .pager,
      .actions,
      .tabs {
        display: flex;
        gap: .75rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .rankings {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: .6rem;
      }

      .rank-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: .6rem;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: .55rem .7rem;
        background: var(--surface-2);
      }

      .rank-actions { display: flex; gap: .35rem; }
      .rank-actions button { padding: .35rem .55rem; font-size: .85rem; }

      .add-row {
        display: grid;
        grid-template-columns: 1fr 150px;
        gap: .6rem;
      }

      .summary-list { margin: .5rem 0 0 1.1rem; }
      .error, .danger { color: var(--negative); }
      .error { margin: .5rem 0 0; min-height: 1.2rem; }

      .toolbar {
        display: flex;
        gap: .75rem;
        align-items: center;
        margin-bottom: 1rem;
      }

      .toolbar input { min-width: 230px; }
      ol { margin: .35rem 0 0 1.4rem; padding: 0; }
      li { margin: .5rem 0; }

      .metric .k { color: var(--text-muted); font-size: .88rem; }
      .metric .v { margin-top: .25rem; font-size: 1.45rem; font-weight: 700; }
      .chart-wrap { margin-top: .55rem; }
      #trendChart { width: 100%; height: 170px; display: block; }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .6rem;
      }

      details > summary {
        cursor: pointer;
        color: var(--accent);
        font-weight: 600;
      }

      .sortable { cursor: pointer; user-select: none; }
      .sortable:hover { color: var(--accent); }
      .hide-sm { display: table-cell; }

      @media (max-width: 900px) {
        .grid { grid-template-columns: 1fr; }
        .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }

      @media (max-width: 760px) {
        .hide-sm { display: none; }
      }

      @media (max-width: 620px) {
        .container { padding: 1.35rem .75rem 2rem; }
        .grid,
        .meta,
        .add-row,
        .stat-grid { grid-template-columns: 1fr; }
        .toolbar input { min-width: 0; width: 100%; }
      }
    </style>


  </head>
  <body>
    <div class="container">
      <div class="nav">
        <a href="/pods">Pods</a>
        <a href="/pods/{{ .Pod.Slug }}">{{ .Pod.Name }}</a>
        <a href="/pods/{{ .Pod.Slug }}/submit">Submit</a>
      </div>

      <h1 style="margin:0;">Submit Game to {{ .Pod.Name }}</h1>
      <p class="muted" style="margin:.35rem 0 1rem;">Format: {{ .Pod.Format }}. Step 1 is required; Steps 2-3 are optional.</p>

      <form id="podSubmitForm" method="post" action="/pods/{{ .Pod.Slug }}/submit/create" class="card">
        <input type="hidden" name="csrf_token" value="{{ .Nav.CSRFToken }}" />
        <div id="payloadFields"></div>

        <div class="card" style="margin:0 0 1rem 0;">
          <h2 style="margin-top:0;">Step 1 - Players & Placements</h2>
          <div class="grid">
            <div>
              <label for="played_at">Played At</label>
              <input id="played_at" name="played_at" type="datetime-local" value="{{ .NowLocal }}" />
            </div>
          </div>

          <label for="player_name" style="margin-top:.75rem;">Add Player (pod members autocomplete, or guest name)</label>
          <div class="add-row">
            <input id="player_name" type="text" list="known-players" placeholder="Type player name" />
            <button id="add_player" type="button">Add Player</button>
          </div>
          <datalist id="known-players">
            {{- range .Players }}<option value="{{ . }}"></option>{{ end -}}
          </datalist>

          <p class="muted" style="margin:.75rem 0 .4rem;">Placements (winner first)</p>
          <ul id="rankings" class="rankings"></ul>

          <div class="card" style="margin:.8rem 0 0 0;">
            <h3 style="margin:0;">Live Elo Preview</h3>
            <p class="muted" style="margin:.35rem 0 .6rem;">Based on current pod Elo scores.</p>
            <ul id="deltaPreview" class="summary-list"></ul>
          </div>
          <p id="formError" class="error"></p>
        </div>

        <details class="card" style="margin:0 0 1rem 0;">
          <summary>Step 2 - Game Details (Optional)</summary>
          <div style="margin-top:.7rem;">
            <label for="turn_count">Turn Count</label>
            <input id="turn_count" name="turn_count" type="number" min="1" step="1" />

            <label for="notes" style="margin-top:.75rem;">Notes</label>
            <textarea id="notes" name="notes" placeholder="Any game notes..."></textarea>
          </div>
        </details>

        <details class="card" style="margin:0 0 1rem 0;">
          <summary>Step 3 - Per-player Stats (Optional)</summary>
          <div id="playerStats" style="margin-top:.7rem;"></div>
        </details>

        <div class="card" id="confirmCard" style="display:none;">
          <h3 style="margin-top:0;">Confirm Submission</h3>
          <p class="muted">Review placements and predicted Elo changes, then confirm.</p>
          <ul id="confirmSummary" class="summary-list"></ul>
          <div class="actions" style="margin-top:.8rem;">
            <button type="button" id="editButton">Edit</button>
            <button type="submit">Confirm & Submit</button>
          </div>
        </div>

        <div class="actions">
          <button type="button" id="reviewButton">Review Submission</button>
        </div>
      </form>
    </div>

    <script>
      (function () {
        const defaultElo = 1500;
        const k = 40;
        const d = 800;
        const currentElos = {
          {{- range $name, $elo := .CurrentElos }}
          {{ printf "%q" $name }}: {{ $elo }},
          {{- end }}
        };

        const playerInput = document.getElementById('player_name');
        const addPlayerButton = document.getElementById('add_player');
        const rankingsEl = document.getElementById('rankings');
        const statsEl = document.getElementById('playerStats');
        const deltaPreviewEl = document.getElementById('deltaPreview');
        const formErrorEl = document.getElementById('formError');
        const reviewButton = document.getElementById('reviewButton');
        const editButton = document.getElementById('editButton');
        const confirmCard = document.getElementById('confirmCard');
        const confirmSummary = document.getElementById('confirmSummary');
        const form = document.getElementById('podSubmitForm');
        const payloadFields = document.getElementById('payloadFields');

        const rankings = [];
        const stats = {};
        let reviewed = false;

        function cloneSnapshot() {
          const out = {};
          for (const key of Object.keys(currentElos)) {
            out[key] = Number(currentElos[key]);
          }
          return out;
        }

        function score(rankingsList) {
          const ratings = rankingsList.map((name) => Number.isFinite(currentElos[name]) ? currentElos[name] : (cloneSnapshot()[name] || defaultElo));
          const deltas = new Array(rankingsList.length).fill(0);

          for (let i = 0; i < rankingsList.length; i += 1) {
            for (let j = i + 1; j < rankingsList.length; j += 1) {
              const ra = ratings[i];
              const rb = ratings[j];
              const ea = 1 / (1 + Math.pow(10, (rb - ra) / d));
              const deltaA = k * (1 - ea);
              deltas[i] += deltaA;
              deltas[j] -= deltaA;
            }
          }

          const result = {};
          rankingsList.forEach((name, idx) => {
            result[name] = Math.round(deltas[idx]);
          });
          return result;
        }

        function setError(msg) {
          formErrorEl.textContent = msg || '';
        }

        function invalidateReview() {
          reviewed = false;
          confirmCard.style.display = 'none';
        }

        function getStatsForPlayer(player) {
          if (!stats[player]) {
            stats[player] = {
              deck: '',
              finalLife: '',
              eliminations: '',
              cmdDealt: '',
              cmdTaken: '',
              turnEliminated: ''
            };
          }
          return stats[player];
        }

        function renderRankings() {
          rankingsEl.innerHTML = '';
          rankings.forEach((player, idx) => {
            const li = document.createElement('li');
            li.className = 'rank-item';

            const label = document.createElement('div');
            label.innerHTML = '<strong>' + (idx + 1) + '.</strong> ' + player;

            const actions = document.createElement('div');
            actions.className = 'rank-actions';

            const up = document.createElement('button');
            up.type = 'button';
            up.textContent = 'Up';
            up.disabled = idx === 0;
            up.addEventListener('click', () => {
              const tmp = rankings[idx - 1];
              rankings[idx - 1] = rankings[idx];
              rankings[idx] = tmp;
              renderAll();
            });

            const down = document.createElement('button');
            down.type = 'button';
            down.textContent = 'Down';
            down.disabled = idx === rankings.length - 1;
            down.addEventListener('click', () => {
              const tmp = rankings[idx + 1];
              rankings[idx + 1] = rankings[idx];
              rankings[idx] = tmp;
              renderAll();
            });

            const remove = document.createElement('button');
            remove.type = 'button';
            remove.textContent = 'Remove';
            remove.addEventListener('click', () => {
              rankings.splice(idx, 1);
              renderAll();
            });

            actions.appendChild(up);
            actions.appendChild(down);
            actions.appendChild(remove);
            li.appendChild(label);
            li.appendChild(actions);
            rankingsEl.appendChild(li);
          });
        }

        function renderPreview() {
          deltaPreviewEl.innerHTML = '';
          if (rankings.length < 2) {
            const item = document.createElement('li');
            item.className = 'muted';
            item.textContent = 'Add at least 2 players to see Elo changes.';
            deltaPreviewEl.appendChild(item);
            return;
          }
          const deltas = score(rankings);
          rankings.forEach((player) => {
            const delta = deltas[player] || 0;
            const li = document.createElement('li');
            li.className = delta > 0 ? 'delta-pos' : (delta < 0 ? 'delta-neg' : 'delta-zero');
            li.textContent = player + ': ' + (delta > 0 ? '+' : '') + delta;
            deltaPreviewEl.appendChild(li);
          });
        }

        function renderStats() {
          statsEl.innerHTML = '';
          rankings.forEach((player) => {
            const current = getStatsForPlayer(player);
            const block = document.createElement('div');
            block.className = 'player-block';

            const title = document.createElement('p');
            title.innerHTML = '<strong>' + player + '</strong>';
            title.style.margin = '0 0 .55rem';
            block.appendChild(title);

            const grid = document.createElement('div');
            grid.className = 'stat-grid';

            function addField(labelText, key, type, min) {
              const wrap = document.createElement('div');
              const label = document.createElement('label');
              label.textContent = labelText;
              const input = document.createElement('input');
              input.type = type;
              if (min !== undefined) input.min = String(min);
              input.value = current[key] || '';
              input.addEventListener('input', () => {
                current[key] = input.value;
                invalidateReview();
              });
              wrap.appendChild(label);
              wrap.appendChild(input);
              grid.appendChild(wrap);
            }

            addField('Deck / Commander', 'deck', 'text');
            addField('Final life total', 'finalLife', 'number');
            addField('Eliminations', 'eliminations', 'number', 0);
            addField('Commander dmg dealt', 'cmdDealt', 'number', 0);
            addField('Commander dmg taken', 'cmdTaken', 'number', 0);
            addField('Turn eliminated', 'turnEliminated', 'number', 1);

            block.appendChild(grid);
            statsEl.appendChild(block);
          });
        }

        function renderAll() {
          renderRankings();
          renderPreview();
          renderStats();
          invalidateReview();
        }

        function addPlayer() {
          const name = playerInput.value.trim();
          if (!name) return;
          if (rankings.includes(name)) {
            setError('That player is already in the rankings.');
            return;
          }
          rankings.push(name);
          playerInput.value = '';
          setError('');
          renderAll();
        }

        function appendHidden(name, value) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          input.value = value;
          payloadFields.appendChild(input);
        }

        function validateRankings() {
          if (rankings.length < 2) {
            setError('At least two players are required.');
            return false;
          }
          const uniq = new Set(rankings);
          if (uniq.size !== rankings.length) {
            setError('Duplicate players are not allowed.');
            return false;
          }
          setError('');
          return true;
        }

        function buildConfirmation() {
          if (!validateRankings()) return false;

          confirmSummary.innerHTML = '';
          const deltas = score(rankings);
          rankings.forEach((player, idx) => {
            const li = document.createElement('li');
            const delta = deltas[player] || 0;
            li.textContent = (idx + 1) + '. ' + player + ' (' + (delta > 0 ? '+' : '') + delta + ')';
            confirmSummary.appendChild(li);
          });

          reviewed = true;
          confirmCard.style.display = 'block';
          return true;
        }

        addPlayerButton.addEventListener('click', addPlayer);
        playerInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            addPlayer();
          }
        });

        reviewButton.addEventListener('click', () => {
          buildConfirmation();
        });

        editButton.addEventListener('click', () => {
          invalidateReview();
        });

        form.addEventListener('submit', (e) => {
          if (!reviewed) {
            e.preventDefault();
            buildConfirmation();
            return;
          }

          payloadFields.innerHTML = '';
          rankings.forEach((player) => {
            appendHidden('placement', player);
            const playerStats = getStatsForPlayer(player);
            appendHidden('stat_player', player);
            appendHidden('stat_deck', playerStats.deck || '');
            appendHidden('stat_final_life', playerStats.finalLife || '');
            appendHidden('stat_eliminations', playerStats.eliminations || '');
            appendHidden('stat_cmd_dealt', playerStats.cmdDealt || '');
            appendHidden('stat_cmd_taken', playerStats.cmdTaken || '');
            appendHidden('stat_turn_eliminated', playerStats.turnEliminated || '');
          });
        });
      })();
    </script>
    <script>document.addEventListener('DOMContentLoaded', function () { document.body.classList.add('loaded'); });</script>
  </body>
</html>
