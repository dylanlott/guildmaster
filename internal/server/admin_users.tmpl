<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="https://fav.farm/👑" />
    <title>Guildmaster - Users</title>
    <style>
      :root {
        --bg: #09090b;
        --surface: #111113;
        --surface-2: #18181b;
        --border: #27272a;
        --text: #e4e4e7;
        --text-muted: #71717a;
        --accent: #f7d126;
        --danger: #f87171;
        --radius-sm: 6px;
        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.5;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1rem 2.8rem;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover { text-decoration: underline; }

      .nav {
        display: flex;
        gap: .75rem;
        margin-bottom: 1rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .nav a,
      .nav span {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
      }

      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
      }

      .nav-right form { margin: 0; }

      .muted { color: var(--text-muted); }
      .danger { color: var(--danger); }

      table {
        width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
      }

      th,
      td {
        text-align: left;
        padding: .65rem .75rem;
        border-bottom: 1px solid var(--border);
      }

      thead th {
        background: var(--surface-2);
        color: var(--text-muted);
        font-size: .74rem;
        text-transform: uppercase;
        letter-spacing: .06em;
      }

      tbody tr:last-child td { border-bottom: none; }

      form.role-form {
        display: flex;
        gap: .5rem;
        align-items: center;
      }

      select,
      button {
        background: #0f0f12;
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: .48rem .6rem;
        font: inherit;
      }

      button {
        cursor: pointer;
        font-weight: 700;
      }

      button:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      button:disabled,
      select:disabled {
        cursor: not-allowed;
        opacity: .55;
      }

      @media (max-width: 720px) {
        table,
        thead,
        tbody,
        tr,
        th,
        td { display: block; }

        thead { display: none; }
        tr { border-bottom: 1px solid var(--border); padding: .65rem 0; }
        td { border-bottom: none; padding: .25rem .75rem; }
        form.role-form { align-items: stretch; flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="nav">
        <a href="/">Leaderboard</a>
        <a href="/games">Game History</a>
        <a href="/pods">Pods</a>
        <a href="/submit">Submit Game</a>
        {{ if .Nav.CanAdmin }}<a href="/admin/users">Users</a>{{ end }}
        <div class="nav-right">
        {{ if .Nav.LoggedIn }}
          <span class="muted">@{{ .Nav.Username }}</span>
          <form method="post" action="/logout"><input type="hidden" name="csrf_token" value="{{ .Nav.CSRFToken }}" /><button type="submit">Logout</button></form>
        {{ else }}
          <a href="/login">Login</a>
        {{ end }}
        </div>
      </div>

      <h1 style="margin:0;">Users</h1>
      <p class="muted" style="margin:.35rem 0 1rem;">Owners can change roles. Admins can review access.</p>

      {{ if .Error }}
      <p class="danger">{{ .Error }}</p>
      {{ end }}

      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Display name</th>
            <th>Role</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
        {{ range .Users }}
          <tr>
            <td>@{{ .Username }}</td>
            <td>{{ .DisplayName }}</td>
            <td>
              <form class="role-form" method="post" action="/admin/users">
                <input type="hidden" name="csrf_token" value="{{ $.Nav.CSRFToken }}" />
                <input type="hidden" name="user_id" value="{{ .ID }}" />
                <select name="role" {{ if not $.CanManage }}disabled{{ end }}>
                  <option value="member" {{ if eq .Role "member" }}selected{{ end }}>Member</option>
                  <option value="admin" {{ if eq .Role "admin" }}selected{{ end }}>Admin</option>
                  <option value="owner" {{ if eq .Role "owner" }}selected{{ end }}>Owner</option>
                </select>
                <button type="submit" {{ if not $.CanManage }}disabled{{ end }}>Save</button>
              </form>
            </td>
            <td>{{ .CreatedAt.Format "2006-01-02" }}</td>
          </tr>
        {{ end }}
        </tbody>
      </table>
    </div>
  </body>
</html>
