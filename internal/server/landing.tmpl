<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="https://fav.farm/👑" />
    <link rel="apple-touch-icon" href="https://fav.farm/👑" />
    <title>Guildmaster 👑 - Leaderboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
            <style>
      :root {
        --bg: #09090b;
        --surface: #111113;
        --surface-2: #18181b;
        --surface-3: #1e1e23;
        --border: #27272a;
        --border-2: #3f3f46;
        --text: #e4e4e7;
        --text-muted: #71717a;
        --accent: #f7d126;
        --accent-dim: rgba(247,209,38,.15);
        --positive: #49a078;
        --negative: #c62f3b;
        --radius: 10px;
        --radius-sm: 6px;
        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; }

      @keyframes fade-up {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes pulse-accent {
        0%, 100% { box-shadow: 0 0 0 0 rgba(247,209,38,.5); }
        60% { box-shadow: 0 0 0 6px rgba(247,209,38,0); }
      }

      @keyframes shimmer {
        0% { transform: translateX(-120%); }
        100% { transform: translateX(120%); }
      }

      body {
        margin: 0;
        font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        background:
          radial-gradient(120% 80% at 15% -10%, rgba(247, 209, 38, .11) 0%, transparent 48%),
          radial-gradient(80% 60% at 100% 0%, rgba(255,255,255,.045) 0%, transparent 60%),
          linear-gradient(180deg, #0b0b0f 0%, #09090b 46%, #070709 100%);
        color: var(--text);
        line-height: 1.5;
      }

      .container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
      }

      h1, h2, h3 {
        color: var(--text);
        letter-spacing: -0.02em;
      }

      .display {
        font-family: 'Cinzel', Georgia, serif;
        letter-spacing: .03em;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        color: var(--accent);
        text-decoration: underline;
      }

      .nav {
        display: flex;
        gap: .75rem;
        margin-bottom: 1rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .nav a,
      .nav span {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
      }

      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
      }

      .nav-right form { margin: 0; }

      .muted,
      .subtitle,
      label {
        color: var(--text-muted);
      }

      .card,
      .metric,
      .player-block,
      details.card,
      table {
        opacity: 0;
        transform: translateY(10px);
      }

      body.loaded .card,
      body.loaded .metric,
      body.loaded .player-block,
      body.loaded details.card,
      body.loaded table {
        animation: fade-up .42s ease both;
      }

      .card,
      .metric,
      .player-block,
      details.card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 12px 34px rgba(0,0,0,.42);
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
      }

      .card:last-child,
      details.card:last-child { margin-bottom: 0; }

      .card::before,
      .metric::before,
      .player-block::before,
      details.card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        height: 1px;
        width: 100%;
        background: linear-gradient(90deg, transparent 0%, var(--accent) 50%, transparent 100%);
        opacity: 0;
        pointer-events: none;
      }

      .card:hover,
      .metric:hover,
      .player-block:hover,
      details.card:hover {
        transform: translateY(-2px);
        border-color: var(--border-2);
        box-shadow: 0 16px 38px rgba(0,0,0,.5), 0 0 0 1px rgba(247,209,38,.16), 0 0 24px rgba(247,209,38,.3);
      }

      .card:hover::before,
      .metric:hover::before,
      .player-block:hover::before,
      details.card:hover::before {
        opacity: .95;
        animation: shimmer .9s ease;
      }

      .row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding: .7rem 0;
      }

      .row:last-child { border-bottom: none; }

      table {
        width: 100%;
        border-collapse: collapse;
        font-variant-numeric: tabular-nums;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
      }

      th,
      td {
        text-align: left;
        padding: .56rem .66rem;
        border-bottom: 1px solid var(--border);
      }

      thead th {
        background: var(--surface-2);
        color: var(--text-muted);
        font-size: .74rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        font-weight: 700;
      }

      tbody tr { transition: background .15s ease; }
      tbody tr:hover { background: rgba(247,209,38,.06); }
      tbody tr:last-child td { border-bottom: none; }

      .num { text-align: right; }
      .pos, .delta-pos { color: var(--positive); font-weight: 700; }
      .neg, .delta-neg { color: var(--negative); font-weight: 700; }
      .zero, .delta-zero { color: var(--text-muted); }

      button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        width: 100%;
        border: 1px solid rgba(247,209,38,.28);
        border-radius: var(--radius-sm);
        background: linear-gradient(180deg, #f7d126 0%, #e8be20 100%);
        color: #1b1808;
        font-weight: 700;
        padding: .55rem .72rem;
        cursor: pointer;
        transition: transform .16s ease, filter .16s ease, box-shadow .16s ease;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        width: auto;
        border: 1px solid rgba(247,209,38,.28);
        border-radius: var(--radius-sm);
        background: linear-gradient(180deg, #f7d126 0%, #e8be20 100%);
        color: #1b1808;
        font-weight: 700;
        padding: .55rem .72rem;
        text-decoration: none;
        transition: transform .16s ease, filter .16s ease, box-shadow .16s ease;
      }

      button:hover,
      .btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.03);
        box-shadow: 0 0 0 1px rgba(247,209,38,.22), 0 8px 20px rgba(247,209,38,.24);
        text-decoration: none;
      }

      button:focus-visible,
      .btn:focus-visible,
      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 2px rgba(247,209,38,.2);
      }

      .nav-right button,
      .nav-right .btn,
      .rank-actions button,
      .actions button,
      .add-row button {
        width: auto;
      }

      input,
      select,
      textarea {
        width: 100%;
        background: var(--surface-2);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: .55rem .65rem;
      }

      textarea { min-height: 90px; resize: vertical; }

      label {
        display: block;
        font-size: .9rem;
        margin-bottom: .35rem;
      }

      .field { margin-bottom: .7rem; }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
      }

      .meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
      }

      .pager,
      .actions,
      .tabs {
        display: flex;
        gap: .75rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .rankings {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: .6rem;
      }

      .rank-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: .6rem;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: .55rem .7rem;
        background: var(--surface-2);
      }

      .rank-actions { display: flex; gap: .35rem; }
      .rank-actions button { padding: .35rem .55rem; font-size: .85rem; }

      .add-row {
        display: grid;
        grid-template-columns: 1fr 150px;
        gap: .6rem;
      }

      .summary-list { margin: .5rem 0 0 1.1rem; }
      .error, .danger { color: var(--negative); }
      .error { margin: .5rem 0 0; min-height: 1.2rem; }

      .hero {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(247,209,38,.18);
        border-radius: 22px;
        padding: 1.35rem;
        margin-bottom: 1rem;
        background:
          radial-gradient(circle at top right, rgba(247,209,38,.2), transparent 32%),
          linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.01)),
          linear-gradient(180deg, #111114 0%, #0d0d11 100%);
        box-shadow: 0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.03);
      }

      .hero::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(120deg, transparent 0%, rgba(247,209,38,.08) 18%, transparent 36%);
        mix-blend-mode: screen;
      }

      .hero-top {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
        flex-wrap: wrap;
        margin-bottom: 1rem;
      }

      .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .18em;
        color: var(--accent);
        margin-bottom: .75rem;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(2.1rem, 5vw, 4rem);
        line-height: .95;
      }

      .hero p {
        margin: .85rem 0 0;
        max-width: 60ch;
        color: #c9c9d2;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .7rem .9rem;
        border: 1px solid rgba(247,209,38,.22);
        background: rgba(247,209,38,.08);
        color: #f8e58d;
        border-radius: 999px;
        font-weight: 700;
        white-space: nowrap;
      }

      .hero-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem;
      }

      .hero-stat {
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: .9rem 1rem;
        background: rgba(255,255,255,.025);
        backdrop-filter: blur(8px);
      }

      .hero-stat .k { color: var(--text-muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; }
      .hero-stat .v { margin-top: .2rem; font-size: 1.45rem; font-weight: 800; }

      .toolbar {
        display: flex;
        gap: .75rem;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .toolbar-copy {
        color: var(--text-muted);
        font-size: .95rem;
      }

      .toolbar input { min-width: 260px; }
      ol { margin: .35rem 0 0 1.4rem; padding: 0; }
      li { margin: .5rem 0; }

      .podium {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem;
        margin-bottom: 1rem;
      }

      .podium-card {
        position: relative;
        overflow: hidden;
        border-radius: 18px;
        padding: 1rem;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.015));
      }

      .podium-card::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(180deg, rgba(247,209,38,.13), transparent 45%);
        opacity: .55;
      }

      .podium-card.gold {
        border-color: rgba(247,209,38,.38);
        box-shadow: 0 18px 38px rgba(247,209,38,.13);
      }

      .podium-rank {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-bottom: .8rem;
        color: var(--accent);
        font-size: .82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
      }

      .podium-name {
        font-size: 1.2rem;
        font-weight: 800;
        margin-bottom: .35rem;
      }

      .podium-name a { color: var(--text); }
      .podium-meta {
        color: var(--text-muted);
        font-size: .94rem;
      }

      .metric .k { color: var(--text-muted); font-size: .88rem; }
      .metric .v { margin-top: .25rem; font-size: 1.45rem; font-weight: 700; }
      .chart-wrap { margin-top: .55rem; }
      #trendChart { width: 100%; height: 170px; display: block; }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .6rem;
      }

      details > summary {
        cursor: pointer;
        color: var(--accent);
        font-weight: 600;
      }

      .sortable { cursor: pointer; user-select: none; }
      .sortable:hover { color: var(--accent); }
      .hide-sm { display: table-cell; }

      @media (max-width: 900px) {
        .grid { grid-template-columns: 1fr; }
        .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .hero-stats,
        .podium { grid-template-columns: 1fr; }
      }

      @media (max-width: 760px) {
        .hide-sm { display: none; }
      }

      @media (max-width: 620px) {
        .container { padding: 1.1rem .75rem 2rem; }
        .grid,
        .meta,
        .add-row,
        .stat-grid,
        .hero-stats,
        .podium { grid-template-columns: 1fr; }
        .toolbar input { min-width: 0; width: 100%; }
        .hero h1 { font-size: 2.4rem; }
      }
    </style>


  </head>
  <body>
    <div class="container">
      <section class="hero">
        <div class="hero-top">
          <div>
            <div class="hero-kicker">👑 Crown Table Rankings</div>
            <h1 class="display">Guildmaster 👑</h1>
            <p>Competitive pods, sharp score swings, and a leaderboard that actually feels like winning matters. Track the table, chase the crown, and keep the receipts.</p>
          </div>
          <div class="hero-badge">👑 Live leaderboard</div>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">
            <div class="k">Ranked players</div>
            <div class="v">{{ .PlayerCount }}</div>
          </div>
          <div class="hero-stat">
            <div class="k">Recent games shown</div>
            <div class="v">{{ len .Games }}</div>
          </div>
          <div class="hero-stat">
            <div class="k">Current crown holder</div>
            <div class="v">{{ if gt (len .Ranked) 0 }}{{ (index .Ranked 0).Name }}{{ else }}—{{ end }}</div>
          </div>
        </div>
      </section>

      <div class="nav">
        <a href="/">Leaderboard</a>
        <a href="/games">Game History</a>
        <a href="/pods">Pods</a>
        <a href="/submit">Submit Game</a>
        {{ if .Nav.CanAdmin }}<a href="/admin/users">Users</a>{{ end }}
        <div class="nav-right">
        {{ if .Nav.LoggedIn }}
          <span class="muted">@{{ .Nav.Username }}</span>
          <form method="post" action="/logout"><input type="hidden" name="csrf_token" value="{{ .Nav.CSRFToken }}" /><button type="submit">Logout</button></form>
        {{ else }}
          <a href="/login">Login</a>
        {{ end }}
        </div>
      </div>

      <section class="podium">
        {{ range .Ranked }}
          {{ if le .Rank 3 }}
          <article class="podium-card {{ if eq .Rank 1 }}gold{{ end }}">
            <div class="podium-rank">{{ if eq .Rank 1 }}👑{{ else if eq .Rank 2 }}⚔️{{ else }}🛡️{{ end }} Rank {{ .Rank }}</div>
            <div class="podium-name"><a href="/players/{{ .Name | urlquery }}">{{ .Name }}</a></div>
            <div class="podium-meta">{{ .Elo }} Elo · {{ .GamesPlayed }} games · <span class="{{ deltaClass .Delta }}">{{ if gt .Delta 0 }}+{{ end }}{{ .Delta }}</span> delta</div>
          </article>
          {{ end }}
        {{ end }}
      </section>

      <div class="toolbar">
        <div class="toolbar-copy">Filter the table, scout momentum, and see who’s closest to the crown.</div>
        <input id="playerFilter" placeholder="Filter players..." aria-label="Filter players" />
      </div>

      <div class="card">
        <h2 class="display" style="margin-top:0; margin-bottom:.8rem;">Full Rankings</h2>
        <table id="leaderboardTable">
          <thead>
            <tr>
              <th class="sortable" data-key="rank" data-type="number">#</th>
              <th class="sortable" data-key="name" data-type="string">Player</th>
              <th class="sortable num" data-key="elo" data-type="number">Elo</th>
              <th class="sortable num" data-key="delta" data-type="number">Delta</th>
              <th class="sortable num" data-key="games" data-type="number">Games</th>
              <th class="sortable num" data-key="winrate" data-type="number">Win Rate</th>
            </tr>
          </thead>
          <tbody>
          {{- range .Ranked }}
            <tr data-rank="{{ .Rank }}" data-name="{{ .Name }}" data-elo="{{ .Elo }}" data-delta="{{ .Delta }}" data-games="{{ .GamesPlayed }}" data-winrate="{{ printf "%.2f" .WinRate }}">
              <td class="num">{{ .Rank }}</td>
              <td><a class="player-link" href="/players/{{ .Name | urlquery }}">{{ .Name }}</a></td>
              <td class="num">{{ .Elo }}</td>
              <td class="num {{ deltaClass .Delta }}">{{ if gt .Delta 0 }}+{{ end }}{{ .Delta }}</td>
              <td class="num">{{ .GamesPlayed }}</td>
              <td class="num">{{ printf "%.1f%%" .WinRate }}</td>
            </tr>
          {{- end }}
          </tbody>
        </table>
      </div>

      <div class="card" style="margin-top: 1rem;">
        <h2 style="margin-top:0;">Recent Games</h2>
        <table>
          <thead><tr><th>Date</th><th>Players</th><th class="hide-sm">Source</th></tr></thead>
          <tbody>
          {{- range .Games }}
            <tr>
              <td><a class="player-link" href="/games/{{ .ID }}">{{ humanDate .PlayedAt }}</a></td>
              <td>{{- range $i, $p := .Placements }}{{ if $i }}, {{ end }}{{ $p.Player }}{{- end }}</td>
              <td class="hide-sm muted">{{ .Source }}</td>
            </tr>
          {{- end }}
          </tbody>
        </table>
      </div>
    </div>

    <script>
      (function() {
        const table = document.getElementById('leaderboardTable');
        if (!table) return;
        const tbody = table.querySelector('tbody');
        const headers = table.querySelectorAll('th.sortable');
        const filterInput = document.getElementById('playerFilter');

        let sortKey = 'rank';
        let sortAsc = true;

        function parseValue(row, key, type) {
          const raw = row.dataset[key] || '';
          return type === 'number' ? Number(raw) : raw.toLowerCase();
        }

        function render() {
          const q = (filterInput?.value || '').trim().toLowerCase();
          const rows = Array.from(tbody.querySelectorAll('tr'));
          rows.sort((a, b) => {
            const header = table.querySelector(`th[data-key="${sortKey}"]`);
            const type = header ? header.dataset.type : 'number';
            const av = parseValue(a, sortKey, type);
            const bv = parseValue(b, sortKey, type);
            if (av === bv) return 0;
            if (sortAsc) return av > bv ? 1 : -1;
            return av < bv ? 1 : -1;
          });

          rows.forEach(row => {
            const name = (row.dataset.name || '').toLowerCase();
            row.style.display = !q || name.includes(q) ? '' : 'none';
            tbody.appendChild(row);
          });
        }

        headers.forEach(h => {
          h.addEventListener('click', () => {
            const clicked = h.dataset.key;
            if (clicked === sortKey) {
              sortAsc = !sortAsc;
            } else {
              sortKey = clicked;
              sortAsc = clicked === 'name';
            }
            render();
          });
        });

        if (filterInput) {
          filterInput.addEventListener('input', render);
        }
      })();
    </script>
    <script>document.addEventListener('DOMContentLoaded', function () { document.body.classList.add('loaded'); });</script>
  </body>
</html>
