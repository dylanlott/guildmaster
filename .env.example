# Copy this file to .env and set values before running `docker compose up -d`
# Google Sheets source configuration
SPREADSHEET_ID=""
SCOREBOARD_API_KEY=""

# Admin auth key for protected endpoints and /submit actions
GUILDMASTER_ADMIN_KEY=""

# SQLite database file path and HTTP port
# In Docker Compose this should point to /data so it persists on the mounted volume.
DATABASE_PATH="/data/guildmaster.db"
PORT="8080"
